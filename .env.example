# AFS Assistant configuration
# Copy to .env (cp .env.example .env) and fill in your services. Never commit .env.
# Shell environment variables override values in this file.
# Relative paths are resolved against the project root.

# ---------------------------------------------------------------------------
# Mode and provider
# ---------------------------------------------------------------------------
# demo   = no model calls (offline index install, synthetic demo answers)
# openai = real model services (for either provider below)
AFS_MODE=openai
# openai    = any OpenAI-compatible endpoint (Ollama, vLLM, OpenAI, ...)
# anthropic = Claude via the Anthropic SDK (then the embedding URL/key below are required)
AFS_PROVIDER=openai

# ---------------------------------------------------------------------------
# Text model: routing, agent investigation and answer writing
# ---------------------------------------------------------------------------
AFS_API_BASE=http://localhost:11434/v1
AFS_API_KEY=
AFS_MODEL=qwen3.6:35b-a3b
# Seconds per provider request (1..300)
AFS_PROVIDER_TIMEOUT=120
# Empty omits the parameter; "none" sends it explicitly. Claude: low|medium|high|xhigh|max
AFS_REASONING_EFFORT=none
# Effort for the final answer only; empty uses AFS_REASONING_EFFORT
AFS_ANSWER_REASONING_EFFORT=

# ---------------------------------------------------------------------------
# Embeddings: must match the installed index (afs-official-v2 uses these)
# Empty URL/key inherit the text service.
# ---------------------------------------------------------------------------
AFS_EMBEDDING_API_BASE=
AFS_EMBEDDING_API_KEY=
AFS_EMBEDDING_MODEL=qwen3-embedding:0.6b
AFS_EMBEDDING_DIMENSION=1024
# Texts per embedding request (1..128)
AFS_EMBEDDING_BATCH_SIZE=16

# ---------------------------------------------------------------------------
# Vision: figure descriptions during preparation and live figure inspection
# Empty URL/key inherit the text service.
# ---------------------------------------------------------------------------
AFS_VISION_API_BASE=
AFS_VISION_API_KEY=
AFS_VISION_MODEL=gemma4:31b-it-qat
AFS_VISION_REASONING_EFFORT=
# Seconds per vision request (1..300)
AFS_VISION_TIMEOUT=180
# Parallel image calls during preparation (1..4)
AFS_VISION_WORKERS=1

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Chats, turns and evidence releases
AFS_DATABASE=var/afs.sqlite3
# Originals, page images, crops and caches
AFS_DATA_DIR=data

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
# Candidates per route (lexical and semantic) before rank fusion (1..100)
AFS_CANDIDATE_LIMIT=30
# Reciprocal Rank Fusion constant (1..1000)
AFS_RRF_K=60
# Minimum cosine similarity for semantic candidates (-1..1)
AFS_MIN_SIMILARITY=0.4

# ---------------------------------------------------------------------------
# Agent budgets per answer
# ---------------------------------------------------------------------------
# Tool calls (1..12)
AFS_MAX_TOOL_CALLS=12
# Wall-clock seconds per answer (1..300)
AFS_RUN_TIMEOUT=300
# Model calls incl. routing, answer and repair (4..20)
AFS_MAX_MODEL_CALLS=8
# Bytes of read evidence passed to the answer (4000..64000)
AFS_EVIDENCE_BYTE_BUDGET=24000
# Answer in a background thread so the UI can show progress
AFS_BACKGROUND_ANSWERS=true

# ---------------------------------------------------------------------------
# Document preparation (only for prepare-official / process-materials)
# ---------------------------------------------------------------------------
# Prose chunk size in spaCy tokens (32..2000); official preparation always uses 128
AFS_CHUNK_SIZE=128
# section_aware or sentence
AFS_CHUNKING_STRATEGY=section_aware
# OCR for generic ingestion; the official materials always use Docling OCR
AFS_DO_OCR=false
# Docling render scale for generic ingestion (0.5..3); official materials use 2.0
AFS_IMAGE_SCALE=1.5
